{
  "version": "1.2.2",
  "name": "@cmorales_/touch",
  "module": "/dist/index.js",
  "type": "module",
  "private": false,
  "description": "Creating complex file structures has never been easier. `@cmorales/touch` is a powerful CLI tool that allows you to generate nested directories and files using a simple and intuitive syntax.",
  "license": "MIT",
  "keywords": [
    "cli",
    "scaffold",
    "generator",
    "automation",
    "fs",
    "boilerplate",
    "create",
    "cmorales",
    "touch"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --splitting false",
    "test": "vitest",
    "release": "bun run build && npm publish --access public"
  },
  "bin": {
    "touch": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/bun": "^1.3.9",
    "tsup": "^8.5.1",
    "vitest": "^4.0.18",
    "@types/update-notifier": "^6.0.8"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "cfonts": "^3.3.1",
    "picocolors": "^1.1.1",
    "update-notifier": "^7.3.1"
  }
}